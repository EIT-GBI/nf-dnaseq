// ---------------------------------------------------------------------------
// Minimal end-to-end test profile
// ---------------------------------------------------------------------------
// Uses the nf-core sarscov2 test dataset: a ~30 KB genome and two small paired
// FASTQ sets, fetched over HTTPS so nothing is committed to this repo.
//
// The dataset ships genome.fasta.fai but no BWA index, so the pipeline builds
// the index on the fly via BWA_INDEX.
//
//   nextflow run . -profile test,docker
// ---------------------------------------------------------------------------

params {
    samplesheet     = "${projectDir}/assets/samplesheet_test.csv"
    reference_dir   = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/genome'
    outdir          = 'results_test'

    trimmer         = 'fastp'
    variant_callers = ['bcftools']

    alignment {
        device = 'cpu'
    }

    // The sarscov2 reads are tiny; keep thresholds low enough to call something
    calling {
        min_mapq  = 0
        min_qual  = 0
        ploidy    = 1
        min_depth = 0
    }
}

process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
    cpus   = 2
    memory = 3.GB
}
