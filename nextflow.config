// ---------------------------------------------------------------------------
// nf-dnaseq - short-read DNA-seq pipeline
// ---------------------------------------------------------------------------

manifest {
    name            = 'nf-dnaseq'
    author          = 'EIT Generative Biology Institute'
    homePage        = 'https://github.com/EIT-GBI/nf-dnaseq'
    description     = 'Short-read DNA-seq: trimming, alignment, QC, coverage and variant calling'
    mainScript      = 'main.nf'
    version         = '0.0.0'
    nextflowVersion = '!>=26.04.4'
    // The tool modules are git submodules. Without this, `nextflow run
    // EIT-GBI/nf-dnaseq -r vX.Y.Z` checks out an empty modules/ and every
    // include fails.
    recurseSubmodules = true
}

// ---------------------------------------------------------------------------
// Parameters
// ---------------------------------------------------------------------------
// Defaults for every parameter main.nf reads, so the pipeline starts up with a
// clear error about what is missing rather than a Groovy "No such property".
params {
    // Input: either a samplesheet, or a fastq dir + reference to build one from
    samplesheet      = null
    fastq_dir        = null
    reference_genome = null

    // Directory holding the reference genomes; samplesheet 'reference' column
    // entries are resolved relative to it
    reference_dir    = null

    // Where published results go
    outdir           = 'results'

    // Read trimming: 'fastp' or 'cutadapt'
    trimmer          = 'fastp'

    // Sequencing platform recorded as PL in the BAM read group, for every
    // sample that does not set it in the samplesheet's optional `platform`
    // column. Unset leaves the aligners on their ILLUMINA default.
    platform         = null

    // Alignment
    alignment {
        device = 'cpu'   // 'cpu' for bwa+samtools, 'gpu' for Parabricks
    }

    // Variant calling: any of bcftools, deepvariant, mutect2
    variant_callers  = ['bcftools']

    // Variant filtering thresholds
    min_mapq         = 20
    min_qual         = 20
    ploidy           = 1
    min_depth        = 10

    // Helper scripts, resolved relative to projectDir
    scripts {
        py_samplesheet = './scripts/generate_samplesheet.py'
    }

    // Directory holding the UCSC binaries (bedGraphToBigWig), for -profile local
    ucsc_dir         = null
}

// ---------------------------------------------------------------------------
// Module containers
// ---------------------------------------------------------------------------
// Each module declares the image it was built from, in its own
// conf/module.config, pinned to that module's release version. Nextflow does
// not read a submodule's config on its own, so each is included explicitly.
// Adding a module here is what gives its processes a container.
//
// These come before `profiles`, so -profile dev can override them.
includeConfig 'modules/fastp/conf/module.config'
includeConfig 'modules/bwa/conf/module.config'
includeConfig 'modules/samtools/conf/module.config'
includeConfig 'modules/fastqc/conf/module.config'
includeConfig 'modules/parabricks/conf/module.config'
includeConfig 'modules/bedtools/conf/module.config'
includeConfig 'modules/bcftools/conf/module.config'

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {
    // Test against unreleased module changes: the module configs pin an image
    // version that only exists once that module is released, so point every
    // module back at :latest.
    dev {
        process {
            withName: 'FASTP_.*'    { container = 'ghcr.io/eit-gbi/nf-mod-fastp:latest'    }
            withName: 'BWA_.*'      { container = 'ghcr.io/eit-gbi/nf-mod-bwa:latest'      }
            withName: 'SAMTOOLS_.*' { container = 'ghcr.io/eit-gbi/nf-mod-samtools:latest' }
            withName: 'FASTQC_.*'   { container = 'ghcr.io/eit-gbi/nf-mod-fastqc:latest'   }
            withName: 'BEDTOOLS_.*' { container = 'ghcr.io/eit-gbi/nf-mod-bedtools:latest' }
            withName: 'BCFTOOLS_.*' { container = 'ghcr.io/eit-gbi/nf-mod-bcftools:latest' }
        }
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        apptainer.enabled = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
    }
    local {
        docker.enabled = false
        process {
            // Only prepend the UCSC dir when one was actually given
            withName: BEDTOOLS_BIGWIG {
                beforeScript = { params.ucsc_dir ? "export PATH=${params.ucsc_dir}:\$PATH" : '' }
            }
        }
    }
    cluster {
        docker.enabled       = false
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = '/mnt/lustre/containers/.staging/nf/cache/'
        process.executor     = 'slurm'
        process.queue        = 'cpu'
        process {
            withName: PREPARE_SAMPLESHEET   { cpus = 1;  memory = { 2.GB  * task.attempt } }
            withName: FASTP_TRIM            { cpus = 8;  memory = { 8.GB  * task.attempt } }
            //withName: CUTADAPT            { cpus = 8;  memory = { 8.GB  * task.attempt } }
            withName: FASTQC_FASTQC         { cpus = 4;  memory = { 4.GB  * task.attempt } }
            withName: 'BWA_.*'              { cpus = 16; memory = { 32.GB * task.attempt } }
            withName: 'SAMTOOLS_.*'         { cpus = 8;  memory = { 16.GB * task.attempt } }
            withName: BEDTOOLS_BIGWIG       { cpus = 4;  memory = { 8.GB  * task.attempt } }
            withName: 'BCFTOOLS_.*'         { cpus = 4;  memory = { 8.GB  * task.attempt } }
            // GPU steps: need a GPU partition + Apptainer --nv. Adjust `queue` to your cluster's GPU queue.
            withName: 'PARABRICKS_.*' {
                memory           = 32.GB
                accelerator      = 2
                clusterOptions   = '--gres=gpu:2'   // typed gres (nodes expose gpu:h100:8); keep count == accelerator/--num-gpus
                queue            = 'gpu'
                containerOptions = '--nv'
            }
        }
    }
    test { includeConfig 'conf/test.config' }
}

// ---------------------------------------------------------------------------
// Process defaults
// ---------------------------------------------------------------------------
process {
    // Retry strategy (applies to every profile)
    // Retry only on failures that a fresh attempt with more resources can
    // plausibly fix:
    //   104        connection reset (transient staging / network error)
    //   130..145   killed by a signal - 137 = OOM-kill, 140 = SLURM time
    //              limit, 143 = SIGTERM (preemption / scancel)
    // Anything else is a real error in the tool or the data: 'finish' lets
    // already-running tasks complete, then stops, so you get a clean log
    // instead of a half-cancelled run. Use 'terminate' if you prefer to
    // stop immediately.
    errorStrategy = { (task.exitStatus in (130..145) || task.exitStatus == 104) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = -1   // no global cap; each task governs itself

    // Resource labels used by the modules
    withLabel: process_low    { cpus = 2;  memory = { 4.GB  * task.attempt } }
    withLabel: process_medium { cpus = 6;  memory = { 12.GB * task.attempt } }
    withLabel: process_high   { cpus = 12; memory = { 24.GB * task.attempt } }

    withName: 'FASTP.*' {
        ext.args  = ''
        cpus      = 4
    }
    withName: 'BWA.*' {
        ext.args  = ''
        cpus      = 4
    }
    withName: 'SAMTOOLS.*' {
        ext.args  = ''
        cpus      = 4
    }
    withName: 'FASTQC.*' {
        ext.args  = ''
        cpus      = 4
    }
    withName: 'PARABRICKS.*' {
        ext.args  = ''
        cpus      = 4
    }
    withName: 'BEDTOOLS.*' {
        ext.args  = ''
        cpus      = 4
    }
    withName: 'BCFTOOLS.*' {
        ext.args  = ''
        cpus      = 4
    }
    // BCFTOOLS_CALL used to read params directly. The module now takes plain
    // tool flags, so the pipeline composes them from its own params here.
    withName: BCFTOOLS_CALL {
        ext.args  = { "-q ${params.min_mapq} -a AD,DP" }
        ext.args2 = { "--ploidy ${params.ploidy}" }
        ext.args3 = { "-e 'FMT/DP<${params.min_depth} || QUAL<${params.min_qual}'" }
    }
    // Runs the bundled python script; no tool container needed
    // Local module (not a submodule), so its image is declared here rather than
    // in a modules/*/conf/module.config
    withName: PREPARE_SAMPLESHEET {
        container = 'python:3.12-slim'
        cpus      = 1
    }
}

// ---------------------------------------------------------------------------
// Workflow outputs
// ---------------------------------------------------------------------------
// Nextflow does not wire params.outdir to the output directory automatically,
// so bridge it explicitly. This must come *after* the profiles block: profiles
// may override params.outdir, and this assignment reads whatever value is
// current at the point it runs. -output-dir / -o on the CLI overrides it.
outputDir = params.outdir

workflow.output.mode = 'copy'
