nextflow_pipeline {

    name "nf-dnaseq end-to-end"
    script "../main.nf"

    test("CPU path, bcftools caller, publishes the documented layout") {

        // -output-dir is passed explicitly: the workflow output block does not
        // pick up params.outdir under nf-test (nextflow-io/nextflow#7069)
        options "-output-dir $outputDir"

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success

            def names = { sub -> (new File("$outputDir/$sub").list() ?: []) as List }

            // Published categories the CPU/bcftools path should produce. Names
            // are asserted rather than contents so the test stays stable across
            // tool versions.
            assert names('').containsAll(['alignment', 'bigwig', 'consensus', 'qc', 'trimmed', 'variants'])

            assert names('alignment').containsAll(['SAMPLE1.sorted.bam', 'SAMPLE1.sorted.bam.bai',
                                                   'SAMPLE2.sorted.bam', 'SAMPLE2.sorted.bam.bai'])

            // fastp reports are published; the trimmed FASTQs deliberately are not
            assert names('trimmed').containsAll(['SAMPLE1.fastp.html', 'SAMPLE1.fastp.json'])
            assert !names('trimmed').any { it.endsWith('.trimmed.fastq.gz') }

            assert names('qc/fastqc').size() == 8
            assert names('qc/flagstat').size() == 2
            assert names('bigwig').containsAll(['SAMPLE1.bw', 'SAMPLE2.bw'])
            assert names('variants/bcftools/bcf').size() == 4
            assert names('variants/bcftools/vcf').size() == 4
            assert names('variants/bcftools/csv').size() == 2
            assert names('consensus').size() == 2

            // GPU-only outputs must not appear on the CPU path
            assert !names('variants').contains('deepvariant')
            assert !names('variants').contains('mutect')
        }
    }

    test("GPU path wiring produces the Parabricks outputs") {

        options "-stub-run -output-dir $outputDir"

        when {
            params {
                outdir          = "$outputDir"
                variant_callers = 'bcftools,deepvariant,mutect2'
                alignment       = [device: 'gpu', threads: 2]
            }
        }

        then {
            assert workflow.success

            def names = { sub -> (new File("$outputDir/$sub").list() ?: []) as List }

            assert names('variants/deepvariant/vcf').size() == 2
            assert names('variants/mutect/vcf').size() == 2
            // fq2bam emits duplicate metrics alongside the BAMs
            assert names('alignment').any { it.endsWith('.dup_metrics.txt') }
            // the GPU path must not fall back to bwa/samtools
            assert workflow.trace.tasks().every { !it.name.startsWith('BWA_MEM') }
            assert workflow.trace.tasks().every { !it.name.startsWith('SAMTOOLS_INDEX') }
        }
    }

    test("skip_variant_calling drops the calling stage but keeps the rest") {

        options "-stub-run -output-dir $outputDir"

        when {
            params {
                outdir               = "$outputDir"
                skip_variant_calling = true
                // Left deliberately non-empty: the switch must win over it
                variant_callers      = 'bcftools,deepvariant,mutect2'
            }
        }

        then {
            assert workflow.success

            def names = { sub -> (new File("$outputDir/$sub").list() ?: []) as List }

            // Everything up to and including coverage still runs
            assert names('').containsAll(['alignment', 'bigwig', 'qc', 'trimmed'])

            // ...and nothing downstream of the callers is published. The
            // consensus goes too: it is built from the bcftools calls.
            assert !names('').contains('variants')
            assert !names('').contains('consensus')

            // No caller process was even scheduled
            assert workflow.trace.tasks().every { !it.name.startsWith('BCFTOOLS_') }
            assert workflow.trace.tasks().every { !it.name.startsWith('PARABRICKS_DEEPVARIANT') }
            assert workflow.trace.tasks().every { !it.name.startsWith('PARABRICKS_MUTECTCALLER') }
        }
    }
}
